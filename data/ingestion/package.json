{
  "name": "mapapp-pipeline",
  "version": "1.0.0",
  "description": "Event data pipeline for Mapbox activity map",
  "type": "module",
  "scripts": {
    "migrate-sqlite": "node pipelines/migrate-sqlite-to-supabase.js",
    "intake": "node pipelines/intake.js",
    "geocode-pending": "node pipelines/geocode-pending.js",
    "backfill-categories": "node pipelines/backfill-categories.js",
    "purge-service-trades": "node pipelines/purge-service-trade-venues.js",
    "enrich-venues": "node pipelines/enrich-venues.js",
    "serve": "node pipelines/serve.js",
    "scrape": "node pipelines/scrape.js",
    "scrape:instagram": "node pipelines/scrape.js instagram --skip-geocode",
    "scrape:venues": "node pipelines/scrape.js local-spots --skip-geocode",
    "scrape:genericurl": "node pipelines/scrape.js genericurl --skip-geocode",
    "onboard-source": "node pipelines/onboard-source.js",
    "test-tiktok-extract": "node pipelines/test-tiktok-extract.js"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@supabase/supabase-js": "^2.108.2",
    "apify-client": "^2.24.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "node-fetch": "^3.3.2"
  }
}
