# Copy this file to .env and fill in your values.

# Mapbox — map rendering and venue geocoding (mapbox.com)
MAPBOX_TOKEN=

# Supabase — project URL and keys (supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Instagram scraper — Apify token (apify.com → Settings → Integrations)
# Runs the apify/instagram-post-scraper actor against the accounts listed
# in config/instagram_accounts.json.
APIFY_TOKEN=

# Gemini API — free tier, used for image OCR and event parsing (aistudio.google.com)
GEMINI_API_KEY=

# Reddit scraper — create a free "script" app at reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Eventbrite — reserved, not currently required (scraper uses HTML parsing)
# EVENTBRITE_TOKEN=

# Legacy SQLite path — only needed for npm run migrate-sqlite
DB_PATH=./data/events.db

# Web server port (default: 3000)
# PORT=3000
