# Copy this file to .env and fill in your values.

# Mapbox — map rendering and venue geocoding (mapbox.com)
MAPBOX_TOKEN=

# Supabase — project URL and keys (supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Instagram scraper — Apify token (apify.com → Settings → Integrations)
# Runs the apify/instagram-post-scraper actor against the accounts listed
# in config/instagram_accounts.json.
APIFY_TOKEN=

# Groq API — free tier, no card required, used by the Instagram scraper for
# event parsing from caption text (console.groq.com → API Keys)
GROQ_API_KEY=

# Allowed origin for the /api/import/* routes (the web app's "paste a
# TikTok link" form calls these cross-origin) — e.g. http://localhost:3001
# in dev. Leave unset to allow any origin (fine for local dev only).
WEB_APP_ORIGIN=

# Gemini API — free tier, used by the generic-URL scraper's text extraction
# fallback tiers and the TikTok import's caption/comment extraction
# fallback (aistudio.google.com)
GEMINI_API_KEY=

# Reddit scraper — create a free "script" app at reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Eventbrite — reserved, not currently required (scraper uses HTML parsing)
# EVENTBRITE_TOKEN=

# Legacy SQLite path — only needed for npm run migrate-sqlite
DB_PATH=./data/events.db

# Web server port (default: 3000)
# PORT=3000
