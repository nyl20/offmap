NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Server-only — never NEXT_PUBLIC_. Used solely by the account-deletion route
# (app/api/account/delete) to call the Supabase Admin API. Get this from
# Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# data/ingestion's Express API — the "paste a TikTok link" /submit page
# calls its /api/import/tiktok/* routes directly (see data/ingestion/pipelines/serve.js).
NEXT_PUBLIC_INGESTION_API_URL=http://localhost:3000
