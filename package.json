{
  "name": "offmap",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @offmap/mobile run start",
    "mobile:ios": "npm --workspace @offmap/mobile run ios",
    "mobile:android": "npm --workspace @offmap/mobile run android",
    "mobile:web": "npm --workspace @offmap/mobile run web",
    "web": "npm --workspace @offmap/web run dev",
    "lint": "npm --workspace @offmap/mobile run lint",
    "typecheck": "npm --workspace @offmap/mobile run typecheck"
  }
}
